{
  "name": "@hbe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "monaco": "node scripts/copy-monaco.mjs && node scripts/copy-vendor.mjs",
    "dev": "pnpm monaco && next dev -p 3000",
    "build": "pnpm monaco && next build && node scripts/csp.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hbe/shared": "workspace:*",
    "@hbe/web-runtime": "workspace:*",
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.57.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  }
}
