{
  "name": "hbecode",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter=!@hbe/web run build && pnpm --filter @hbe/web run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "db:migrate": "pnpm --filter @hbe/db run migrate",
    "db:seed": "pnpm --filter @hbe/db run seed",
    "dev:api": "pnpm --filter @hbe/api run dev",
    "dev:web": "pnpm --filter @hbe/web run dev",
    "dev:executor": "pnpm --filter @hbe/executor run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15"
  }
}
