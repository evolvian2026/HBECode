# Copy to .env for docker compose. Never commit real values.
POSTGRES_PASSWORD=hbe_owner_dev
HBE_APP_DB_PASSWORD=hbe_app_dev_password
EXECUTOR_TOKEN=dev-executor-token-change-me-0123456789
SEED_ADMIN_EMAIL=admin@hbecode.local
SEED_ADMIN_PASSWORD=admin-password-dev-1
SEED_DEMO_PASSWORD=demo-password-123
# Optional in development (generated per process if empty); required in production:
#   JWT_PRIVATE_KEY:    openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
#   MFA_ENCRYPTION_KEY: openssl rand -base64 32
JWT_PRIVATE_KEY=
MFA_ENCRYPTION_KEY=

# DB-question runner containers (internal network only; dev defaults in docker-compose.yml)
RUNNER_PG_PASSWORD=
RUNNER_MYSQL_PASSWORD=
RUNNER_MONGO_PASSWORD=

# Use prebuilt images (README quick start) instead of building them locally:
# HBE_IMAGE_PREFIX=ghcr.io/evolvian2026/hbecode-
# HBE_TAG=main
